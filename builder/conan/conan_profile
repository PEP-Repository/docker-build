# Generic Conan profile (default Release)
# See https://docs.conan.io/2/reference/config_files/profiles.html
# Example: CC=clang CXX=clang++ conan install ./ --profile:all=./docker-build/builder/conan/conan_profile

include(./base_conan_profile)

{% set operating_system = detect_api.detect_os() %}
{% set arch = detect_api.detect_arch() %}
{% set compiler, version, compiler_exe = detect_api.detect_default_compiler() %}
{# Unfortunately, at this time we are just given one compiler_exe by Conan #}
{% set c_compiler_exe = compiler_exe %}
{% set cxx_compiler_exe = os.getenv("CXX") or {'cc':'c++', 'clang':'clang++', 'gcc':'g++'}[compiler_exe] or compiler_exe %}

{% if compiler == 'msvc' %}
  {% set runtime, _ = detect_api.default_msvc_runtime(compiler) %}
{% endif %}
{% set libcxx = detect_api.detect_libcxx(compiler, version, compiler_exe) %}

{# Minimum supported macOS version (deployment target) of everything we build #}
{% set macos_version = '13.3' %}

[settings]
build_type=Release

os={{operating_system}}
{% if operating_system == 'Macos' -%}
# Set macOS version to prevent building things for different versions
os.version={{macos_version}}
{%- endif %}
arch={{arch}}
compiler={{compiler}}
{% set major_version = detect_api.default_compiler_version(compiler, version) %}
compiler.version={{major_version}}

{% if libcxx %} compiler.libcxx={{libcxx}} {% endif %}
compiler.cppstd=23

{% if runtime -%}
# MSVC
compiler.runtime={{runtime}}
{%- endif %}

{% if libcxx == 'libstdc++11' -%}
# Add GNU extensions for __int128 support in STL, see https://github.com/qt/qtbase/commit/9bb2ab5978625eee96f703871d5eca8e54b31386
qt/*:compiler.cppstd=gnu23
{%- endif %}

{% if compiler == 'msvc' -%}
# TODO(workaround): see https://gitlab.pep.cs.ru.nl/pep/core/-/work_items/3057
# Qt 6.12 fails when built for C++23 by MSVC (constexpr unique_ptr of incomplete QAbstractFileEngineIterator)
qt/*:compiler.cppstd=20
{%- endif %}

[conf]
{% if compiler_exe -%}
# Specify executables consistent with compiler in settings above
tools.build:compiler_executables={ 'c':'{{c_compiler_exe}}', 'cpp':'{{cxx_compiler_exe}}' }
{%- endif %}

# Build dependencies with Ninja, also with MSVC: much faster than MSBuild, both to configure and to build
tools.cmake.cmaketoolchain:generator=Ninja
# Don't try to build Ninja with itself
ninja/*:tools.cmake.cmaketoolchain:generator=!
{% if compiler == 'msvc' %}
# But keep Conan's default (Visual Studio) generator for our own project, for use in Visual Studio.
#  The Windows CI build of PEP core chooses its own generator, see its ci_cd/windows-ci-build.bat.
&:tools.cmake.cmaketoolchain:generator=!
{% endif %}

{% if operating_system == 'Windows' -%}
# Set Windows version for headers to _WIN32_WINNT_WIN10 / NTDDI_WIN10_RS5,
#  see https://learn.microsoft.com/en-us/windows/win32/winprog/using-the-windows-headers#macros-for-conditional-declarations
# This is based mostly on what Qt6 needs, see https://doc.qt.io/qt-6/supported-platforms.html#windows
#tools.build:defines=['_WIN32_WINNT=0x0A00', 'NTDDI_VERSION=0x0A000006']
#XXX Removed NTDDI_VERSION as workaround for https://github.com/conan-io/conan/issues/15921
tools.build:defines=['_WIN32_WINNT=0x0A00']
{%- endif %}

{% if operating_system == 'Macos' -%}
# We don't want to install full Xcode on macOS, so we disable this check as it doesn't seem to be required for what we do.
#  Note: This is broken in Qt 6.9 - 6.10.2, see https://qt-project.atlassian.net/browse/QTBUG-138427
# Qt picks its deployment target before the Conan toolchain is loaded, so it ignores os.version
#  (falling back to its own default, or something else on the CI runners). FORCE ours instead.
#  See https://github.com/conan-io/conan-center-index/issues/20589 and https://github.com/conan-io/conan/issues/14988.
# On x86_64, Apple's new linker (ld-prime, Xcode 26) fails to link Qt's OpenSSL TLS plugin against static libcrypto:
#  "fixup error (kind=imageOffset32) at 'anon-33' from inits-file, target '_OPENSSL_cpuid_setup' does not have address".
#  The classic linker works, so use it for Qt's plugins.
#  See https://gitlab.pep.cs.ru.nl/pep/core/-/work_items/3061 and https://qt-project.atlassian.net/browse/QTBUG-141933.
#  Note: -ld_classic is deprecated and is removed from Xcode 27. But that version doesn't support x86_64, so that will
#        never be a problem for the x86_64 builds where we use it
qt/*:tools.cmake.cmaketoolchain:extra_variables={'QT_NO_XCODE_MIN_VERSION_CHECK': 'ON', 'CMAKE_OSX_DEPLOYMENT_TARGET': {'value': '{{macos_version}}', 'cache': True, 'type': 'STRING', 'force': True}{% if arch == 'x86_64' %}, 'CMAKE_MODULE_LINKER_FLAGS_INIT': '-Wl,-ld_classic'{% endif %}}
{%- endif %}

[options]
# Static Qt plugins don't work well with Conan,
# plus this saves space if multiple executables use Qt.
# See e.g. https://github.com/conan-io/conan-center-index/issues/23382
qt/*:shared=True

{% if operating_system == 'Macos' -%}
openssl/*:openssldir=/etc/ssl/
{%- endif %}

[tool_requires]
# Provide Ninja (see tools.cmake.cmaketoolchain:generator above).
# See https://github.com/conan-io/conan-center-index/blob/master/docs/faqs.md#why-recipes-that-use-build-tools-like-cmake-that-have-packages-in-conan-center-do-not-use-it-as-a-build-require-by-default
# We prevent a cycle in the build profile using an exclusion pattern,
# see also https://github.com/conan-io/conan/issues/19412
!cmake/*: ninja/[*]
